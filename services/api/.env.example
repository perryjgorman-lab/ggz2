# Server Configuration
PORT=3001
NODE_ENV=development

# Product Database API (UPCitemdb - free tier available)
# Get your key at: https://www.upcitemdb.com/api/docs
UPCITEMDB_API_KEY=your_upcitemdb_api_key_here

# eBay API Credentials (Browse API)
# Get credentials at: https://developer.ebay.com/
EBAY_APP_ID=your_ebay_app_id_here
EBAY_CERT_ID=your_ebay_cert_id_here
EBAY_REDIRECT_URI=your_redirect_uri_here

# Amazon Product Advertising API (Optional)
# Get credentials at: https://affiliate-program.amazon.com/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Cache TTL (in seconds)
PRODUCT_CACHE_TTL=86400
PRICE_CACHE_TTL=1800
