# Server Configuration
PORT=3001
NODE_ENV=development

# Product Database API (UPCitemdb - free tier available)
# Get your key at: https://www.upcitemdb.com/api/docs
UPCITEMDB_API_KEY=

# eBay API Credentials (Browse API - OAuth client credentials)
# Get credentials at: https://developer.ebay.com/
# 1. Create an application at developer.ebay.com
# 2. Get your Client ID (App ID) and Client Secret (Cert ID)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Mock data provider (for development without API keys)
# Set to true to enable mock data; false to use only real APIs
ENABLE_MOCK=false

# Cache TTL (in seconds)
PRODUCT_CACHE_TTL=86400
PRICE_CACHE_TTL=1800
