# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# eBay API (optional - comps will return sampleSize=0 if not configured)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# Reverse Image Search (optional - requires explicit user opt-in)
# Example: Google Vision API, TinEye API, etc.
REVERSE_IMAGE_API_KEY=
REVERSE_IMAGE_PROVIDER=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# CORS
CORS_ORIGIN=*

# Sentry (optional)
SENTRY_DSN=
