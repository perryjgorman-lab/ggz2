# API Configuration
# URL of the Scan2Market API backend
# For local development with Expo Go, use your machine's IP address
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# For production, use your deployed API URL
# EXPO_PUBLIC_API_URL=https://api.scan2market.com
