# Scan2Flip Mobile Environment Configuration

# API Configuration
# URL of the Scan2Flip API backend
# For local development with Expo Go, use your machine's IP address
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# For production, use your deployed API URL
# EXPO_PUBLIC_API_URL=https://api.scan2flip.com

# Free tier scan limit per day (default: 10)
EXPO_PUBLIC_FREE_SCANS_PER_DAY=10
