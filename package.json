{
  "name": "scamsight",
  "version": "1.0.0",
  "private": true,
  "description": "ScamSight - Scam Risk Analyzer for Online Listings",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@scamsight/mobile",
    "mobile:ios": "npm run ios --workspace=@scamsight/mobile",
    "mobile:android": "npm run android --workspace=@scamsight/mobile",
    "api": "npm run dev --workspace=@scamsight/api",
    "api:build": "npm run build --workspace=@scamsight/api",
    "api:start": "npm run start --workspace=@scamsight/api",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test --workspace=@scamsight/shared",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.expo apps/*/dist packages/*/dist"
  },
  "keywords": [
    "scam-detection",
    "marketplace-safety",
    "fraud-prevention"
  ],
  "author": "ScamSight Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^8.57.1"
  }
}
