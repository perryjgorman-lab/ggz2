{
  "name": "scan2market",
  "version": "1.0.0",
  "private": true,
  "description": "Scan barcodes and get estimated resale prices from marketplaces",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:mobile",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
